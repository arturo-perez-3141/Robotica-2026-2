<robot name="rrr_robot">

  <material name="Black">  <color rgba="0 0 0 1.0"/> </material>
  <material name="Yellow"> <color rgba="1 1 0 1.0"/> </material>
  <material name="Green">  <color rgba="0 1 0 1.0"/> </material>
  <material name="Orange"> <color rgba="1 0.5 0 1.0"/> </material>

  <link name="ground_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
      <material name="Black"/>
    </visual>
  </link>

  <link name="link_1_waist">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
      <material name="Yellow"/>
    </visual>
  </link>

  <link name="link_2_upper_arm">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.05 0.05"/>
      </geometry>
      <material name="Green"/>
    </visual>
  </link>

  <link name="link_3_forearm">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.35 0.04 0.04"/>
      </geometry>
      <material name="Orange"/>
    </visual>
  </link>

  <joint name="joint_1_waist" type="revolute">
    <parent link="ground_link"/>
    <child link="link_1_waist"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> <limit effort="10.0" lower="-3.14" upper="3.14" velocity="3.14"/>
  </joint>

  <joint name="joint_2_shoulder" type="revolute">
    <parent link="link_1_waist"/>
    <child link="link_2_upper_arm"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit effort="10.0" lower="-2.5" upper="2.5" velocity="3.14"/>
  </joint>

  <joint name="joint_3_elbow" type="revolute">
    <parent link="link_2_upper_arm"/>
    <child link="link_3_forearm"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit effort="10.0" lower="-2.5" upper="2.5" velocity="3.14"/>
  </joint>

</robot>